    <Style x:Key="ModernUpdateSoftwareButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ModernButtonHoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ModernSelectedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F8FBFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ModernPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ModernPrimaryLightBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasSoftwareUpdateNotice}" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Root" Property="Background" Value="#16A34A" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#15803D" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasSoftwareUpdateNotice}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Root" Property="Background" Value="#15803D" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#15803D" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasSoftwareUpdateNotice}" Value="True" />
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Root" Property="Background" Value="#166534" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#166534" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{StaticResource ModernWeakTextBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#E5EAF2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

