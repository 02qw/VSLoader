                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ModernPrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#BFDBFE" />
