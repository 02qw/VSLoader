<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\tomato.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <CodeCompareProjectPath>$(MSBuildThisFileDirectory)..\..\upAndown\src\UpAndown.CodeCompare\UpAndown.CodeCompare.csproj</CodeCompareProjectPath>
    <CodeCompareBuildOutput>$(MSBuildThisFileDirectory)..\..\upAndown\src\UpAndown.CodeCompare\bin\$(Configuration)\net8.0-windows\</CodeCompareBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="ToolGood.Words.FirstPinyin" Version="3.1.0.4" />
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSLoader.Updater\VSLoader.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyUpdaterToOutput" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'VSLoader'">
    <ItemGroup>
      <UpdaterOutput Include="..\VSLoader.Updater\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\**\*.*" Condition="'$(RuntimeIdentifier)' != ''" />
      <UpdaterOutput Include="..\VSLoader.Updater\bin\$(Configuration)\$(TargetFramework)\**\*.*" Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterOutput)"
          DestinationFiles="@(UpdaterOutput->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCodeCompareToDebugOutput"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'VSLoader' And '$(Configuration)' == 'Debug' And Exists('$(CodeCompareProjectPath)')">
    <MSBuild Projects="$(CodeCompareProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <CodeCompareOutput Include="$(CodeCompareBuildOutput)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CodeCompareOutput)"
          DestinationFiles="@(CodeCompareOutput->'$(OutputPath)Tools\CodeCompare\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\tomato.ico" />
    <Resource Include="Assets\tomato.png" />
    <Resource Include="Assets\setting.png" />
    <Resource Include="Assets\setting3.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\batch-rules.example.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\batch-rules.regex.example.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\batch-rules.v3.zam.example.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\batch-rules.v4.module-map.example.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\factory-map.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
