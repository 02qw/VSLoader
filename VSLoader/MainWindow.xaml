<Window x:Class="VSLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VSLoader.ViewModels"
        mc:Ignorable="d"
        Title="VSLoader"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="720"
        MinHeight="560"
        Width="960"
        MinWidth="900"
        Cursor="{Binding IsBusy, Converter={StaticResource BusyCursorConverter}}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <DockPanel Background="#F6F7F9"
                   IsEnabled="{Binding IsNotBusy}">
            <Border DockPanel.Dock="Top"
                    Margin="16,16,16,0"
                    Padding="12"
                    Background="#FFF4D6"
                    BorderBrush="#E7C160"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#5E4700"
                           TextWrapping="Wrap" />
            </Border>

            <Grid DockPanel.Dock="Top" Margin="16,16,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="36"
                             Padding="10,7"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称、路径、备注搜索" />

                    <TextBlock Grid.Column="1"
                               MinWidth="80"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="13"
                               Foreground="#64748B"
                               Text="{Binding ShortcutCountText}"
                               TextAlignment="Center"
                               ToolTip="当前筛选显示数量 / 总快捷项数量" />

                    <Button Grid.Column="2"
                            Width="76"
                            Height="36"
                            Margin="12,0,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            Content="设置" />
                </Grid>

                <WrapPanel Grid.Row="1"
                           Margin="0,10,0,0"
                           Orientation="Horizontal">
                    <Button Width="96"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding AddShortcutCommand}"
                            Content="新增" />
                    <Button Width="132"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding OpenBatchImportCommand}"
                            Content="批量新增识别" />
                    <Button Width="132"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding DownloadAdminUiLinksCommand}"
                            Content="自动获取连接" />
                    <Button Width="104"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding OpenAdminUiCommand}"
                            Content="AdminUI" />
                    <Button Width="96"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding OpenShortcutCommand}"
                            Content="打开" />
                    <Button Width="96"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding EditShortcutCommand}"
                            Content="编辑" />
                    <Button Width="96"
                            Height="36"
                            Margin="0,0,10,8"
                            Command="{Binding DeleteShortcutCommand}"
                            Content="删除" />
                </WrapPanel>
            </Grid>

            <Border Margin="16,0,16,16"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid x:Name="ShortcutsGrid"
                          AlternatingRowBackground="#FCFCFD"
                          AutoGenerateColumns="False"
                          Background="White"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          ColumnHeaderHeight="38"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          FontFamily="Microsoft YaHei UI"
                          FontSize="14"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#E5E7EB"
                          IsReadOnly="True"
                          ItemsSource="{Binding ShortcutsView}"
                          MouseDoubleClick="ShortcutsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="ShortcutsGrid_PreviewMouseRightButtonDown"
                          RowHeight="44"
                          RowHeaderWidth="0"
                          ScrollViewer.CanContentScroll="True"
                          SelectedItem="{Binding SelectedShortcut, Mode=TwoWay}"
                          SelectionMode="Single"
                          Sorting="ShortcutsGrid_Sorting"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.ContextMenu>
                        <ContextMenu Padding="0"
                                     Background="White"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="White"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <ContextMenu.Resources>
                                <Style x:Key="CompactMenuItemStyle" TargetType="MenuItem">
                                    <Setter Property="MinWidth" Value="130" />
                                    <Setter Property="Padding" Value="14,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#111827" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Border x:Name="Root"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter ContentSource="Header"
                                                                      RecognizesAccessKey="True"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="#E5F1FB" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="#9CA3AF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="AdminUI"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.OpenAdminUiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="获取AdminUI连接"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.DownloadSelectedAdminUiLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="WebUI"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.OpenWebUiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="编辑"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.EditShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="删除"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.DeleteShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB" />
                            <Setter Property="Foreground" Value="#6B7280" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="BorderBrush" Value="#EEF0F3" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Border x:Name="RowBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SelectedIndicator"
                                                        Background="Transparent" />
                                                <DataGridCellsPresenter Grid.Column="1"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="AlternationIndex" Value="1">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#FCFCFD" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#F6FAFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#EEF6FF" />
                                                <Setter TargetName="SelectedIndicator" Property="Background" Value="#2563EB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="5*"
                                            Binding="{Binding Name}"
                                            Header="名称"
                                            SortMemberPath="Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#111827" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="8*"
                                            Binding="{Binding Description}"
                                            Header="备注"
                                            SortMemberPath="Description">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4B5563" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="5*"
                                            Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            Header="更新时间"
                                            SortMemberPath="UpdatedAt">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               FontSize="16"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="10"
                                 Minimum="0"
                                 Maximum="{Binding BusyProgressMaximum}"
                                 Value="{Binding BusyProgressValue}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding BusyProgressText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding BusyCurrentItemText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
