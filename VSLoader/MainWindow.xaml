<Window x:Class="VSLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:chromeControls="clr-namespace:VSLoader.Views.Controls"
        xmlns:behaviors="clr-namespace:VSLoader.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VSLoader.ViewModels"
        mc:Ignorable="d"
        Title="VSLoader"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="720"
        MinHeight="560"
        Width="960"
        MinWidth="900"
        WindowStyle="None"
        Cursor="{Binding IsBusy, Converter={StaticResource BusyCursorConverter}}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource ModernAppBackgroundBrush}"
            BorderBrush="{StaticResource ModernWindowOuterBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid x:Name="MainFocusTarget"
          Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <chromeControls:ModernTitleBar Grid.Row="0" />
        <Grid Grid.Row="1">
        <DockPanel Background="{StaticResource ModernAppBackgroundBrush}"
                   IsEnabled="{Binding IsNotBusy}">
            <Border DockPanel.Dock="Top"
                    Margin="16,16,16,0"
                    Padding="12"
                    Background="#FFF7D6"
                    BorderBrush="#E5B84A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="13"
                           Foreground="#6B4E00"
                           TextWrapping="Wrap" />
            </Border>

            <Border DockPanel.Dock="Top"
                    Margin="16,10,16,0"
                    Padding="12,10"
                    Background="#FFF7D6"
                    BorderBrush="#E5B84A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasUpdateNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#6B4E00"
                               Text="{Binding UpdateNoticeMessage}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ModernWarningBannerActionButtonStyle}"
                            Margin="12,0,0,0"
                            Command="{Binding CloseUpdateNoticeCommand}"
                            Content="我知道了" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Margin="16,10,16,0"
                    Padding="12,10"
                    Background="#FEE2E2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasUpdateFailure, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#7F1D1D"
                               Text="{Binding UpdateFailureMessage}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ModernErrorBannerActionButtonStyle}"
                            Margin="12,0,0,0"
                            Command="{Binding CloseUpdateFailureCommand}"
                            Content="我知道了" />
                </Grid>
            </Border>

            <Grid DockPanel.Dock="Top" Margin="16,16,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="SearchBarRow" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="36"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称、路径、备注搜索" />

                    <TextBlock Grid.Column="1"
                               MinWidth="80"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="13"
                               Foreground="#64748B"
                               Text="{Binding ShortcutCountText}"
                               TextAlignment="Center"
                               ToolTip="当前筛选显示数量 / 总快捷项数量" />

                    <Button Grid.Column="2"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="76"
                            Height="34"
                            Margin="12,0,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            Content="设置" />
                </Grid>

                <WrapPanel x:Name="PrimaryActionRow"
                           Grid.Row="1"
                           Margin="0,12,0,0"
                           Orientation="Horizontal">
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,8"
                            Click="WorkspaceButton_Click"
                            Content="工作区" />
                    <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,8"
                            Command="{Binding AddShortcutCommand}"
                            Content="新增" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,8"
                            Command="{Binding OpenShortcutCommand}"
                            Content="打开" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,8"
                            Command="{Binding EditShortcutCommand}"
                            Content="编辑" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,8"
                            Click="FactoryMapButton_Click"
                            Content="地图" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="104"
                            Height="34"
                            Margin="0,0,8,8"
                            Command="{Binding OpenAdminUiCommand}"
                            Content="AdminUI" />
                    <Button Style="{StaticResource ModernDangerButtonStyle}"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,8"
                            Command="{Binding DeleteShortcutCommand}"
                            Content="删除" />
                </WrapPanel>

                <WrapPanel x:Name="UtilityActionRow"
                           Grid.Row="2"
                           Margin="0,0,0,0"
                           Orientation="Horizontal">
                    <Button Style="{StaticResource ModernUpdateSoftwareButtonStyle}"
                            Width="104"
                            Height="34"
                            Margin="0,0,8,8"
                            Command="{Binding UpdateSoftwareCommand}"
                            Content="更新软件" />
                    <Button Style="{StaticResource ModernQuietButtonStyle}"
                            Width="104"
                            Margin="0,0,8,8"
                            Command="{Binding ManualCheckUpdatesCommand}"
                            Content="检测更新" />
                    <Button Style="{StaticResource ModernQuietButtonStyle}"
                            Width="132"
                            Margin="0,0,8,8"
                            Command="{Binding DownloadAdminUiLinksCommand}"
                            Content="自动获取连接" />
                    <Button Style="{StaticResource ModernQuietButtonStyle}"
                            Width="132"
                            Margin="0,0,8,8"
                            Command="{Binding OpenBatchImportCommand}"
                            Content="批量新增识别" />
                    <Button Style="{StaticResource ModernQuietButtonStyle}"
                            Width="132"
                            Margin="0,0,8,8"
                            Command="{Binding ExportGlobalConfigCommand}"
                            Content="导出全局配置" />
                    <Button Style="{StaticResource ModernQuietButtonStyle}"
                            Width="132"
                            Margin="0,0,8,8"
                            Command="{Binding ImportGlobalConfigCommand}"
                            Content="导入全局配置" />
                </WrapPanel>
            </Grid>

            <Border Margin="16,0,16,16"
                    Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="{StaticResource ModernSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="ShortcutsGrid"
                          Style="{StaticResource ModernDataGridStyle}"
                          AlternatingRowBackground="#FCFCFD"
                          AutoGenerateColumns="False"
                          Background="White"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          ColumnHeaderHeight="38"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          FontFamily="Microsoft YaHei UI"
                          FontSize="14"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#E5E7EB"
                          IsReadOnly="True"
                          ItemsSource="{Binding ShortcutsView}"
                          MouseDoubleClick="ShortcutsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="ShortcutsGrid_PreviewMouseRightButtonDown"
                          RowHeight="40"
                          RowHeaderWidth="0"
                          behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                          behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="True"
                          behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.PanningMode="Both"
                          ScrollViewer.PanningRatio="1"
                          ScrollViewer.PanningDeceleration="0.001"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedShortcut, Mode=TwoWay}"
                          SelectionMode="Single"
                          Sorting="ShortcutsGrid_Sorting"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.ContextMenu>
                        <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                            <MenuItem Header="VSCode"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="AdminUI"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.OpenAdminUiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="获取AdminUI连接"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.DownloadSelectedAdminUiLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="WebUI"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.OpenWebUiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="编辑"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.EditShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="删除"
                                      Style="{StaticResource ModernDangerMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.DeleteShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCellStyle}">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="BorderBrush" Value="#EEF2F7" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Border x:Name="RowBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SelectedIndicator"
                                                        Background="Transparent" />
                                                <DataGridCellsPresenter Grid.Column="1"
                                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="AlternationIndex" Value="1">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#FCFCFD" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#F6FAFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="#EEF6FF" />
                                                <Setter TargetName="SelectedIndicator" Property="Background" Value="#2563EB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="4*"
                                            MinWidth="120"
                                            Binding="{Binding Name}"
                                            Header="名称"
                                            SortMemberPath="Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#111827" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="5*"
                                            MinWidth="180"
                                            Binding="{Binding SourceModuleName}"
                                            Header="原始模块名"
                                            SortMemberPath="SourceModuleName">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#374151" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="ToolTip" Value="{Binding SourceModuleName}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="5*"
                                            MinWidth="160"
                                            Binding="{Binding Description}"
                                            Header="备注"
                                            SortMemberPath="Description">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4B5563" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="4*"
                                            MinWidth="150"
                                            Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            Header="更新时间"
                                            SortMemberPath="UpdatedAt">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <Border Background="#660F172A"
                Visibility="{Binding IsMainBusyOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModernBusyPanelStyle}"
                    Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               FontSize="16"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="10"
                                 Minimum="0"
                                 Maximum="{Binding BusyProgressMaximum}"
                                 Value="{Binding BusyProgressValue}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding BusyProgressText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding BusyCurrentItemText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
