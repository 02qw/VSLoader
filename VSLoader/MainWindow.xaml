<Window x:Class="VSLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VSLoader.ViewModels"
        mc:Ignorable="d"
        Title="VSLoader"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="620"
        MinHeight="520"
        Width="1280"
        MinWidth="1120"
        Cursor="{Binding IsBusy, Converter={StaticResource BusyCursorConverter}}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <DockPanel Background="#F6F7F9"
                   IsEnabled="{Binding IsNotBusy}">
            <Border DockPanel.Dock="Top"
                    Margin="16,16,16,0"
                    Padding="12"
                    Background="#FFF4D6"
                    BorderBrush="#E7C160"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#5E4700"
                           TextWrapping="Wrap" />
            </Border>

            <Grid DockPanel.Dock="Top" Margin="16,16,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Height="36"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按名称、路径、备注搜索" />

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            Orientation="Horizontal">
                    <Button Width="76"
                            Margin="0,0,8,0"
                            Command="{Binding AddShortcutCommand}"
                            Content="新增" />
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Command="{Binding OpenBatchImportCommand}"
                            Content="批量新增识别" />
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Command="{Binding DownloadAdminUiLinksCommand}"
                            Content="自动获取连接" />
                    <Button Width="82"
                            Margin="0,0,8,0"
                            Command="{Binding OpenAdminUiCommand}"
                            Content="AdminUI" />
                    <Button Width="76"
                            Margin="0,0,8,0"
                            Command="{Binding EditShortcutCommand}"
                            Content="编辑" />
                    <Button Width="76"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteShortcutCommand}"
                            Content="删除" />
                    <Button Width="76"
                            Margin="0,0,8,0"
                            Command="{Binding OpenShortcutCommand}"
                            Content="打开" />
                    <Button Width="76"
                            Command="{Binding OpenSettingsCommand}"
                            Content="设置" />
                </StackPanel>
            </Grid>

            <Border Margin="16,0,16,16"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid x:Name="ShortcutsGrid"
                          AlternatingRowBackground="#FAFAFA"
                          AutoGenerateColumns="False"
                          Background="White"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          ColumnHeaderHeight="36"
                          FontFamily="Microsoft YaHei UI"
                          FontSize="14"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#E5E7EB"
                          IsReadOnly="True"
                          ItemsSource="{Binding ShortcutsView}"
                          MouseDoubleClick="ShortcutsGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="ShortcutsGrid_PreviewMouseRightButtonDown"
                          RowHeight="34"
                          RowHeaderWidth="0"
                          SelectedItem="{Binding SelectedShortcut, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.ContextMenu>
                        <ContextMenu Padding="0"
                                     Background="White"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="White"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <ContextMenu.Resources>
                                <Style x:Key="CompactMenuItemStyle" TargetType="MenuItem">
                                    <Setter Property="MinWidth" Value="130" />
                                    <Setter Property="Padding" Value="14,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#111827" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Border x:Name="Root"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter ContentSource="Header"
                                                                      RecognizesAccessKey="True"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="#E5F1FB" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="#9CA3AF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="AdminUI"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.OpenAdminUiCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="编辑"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.EditShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="删除"
                                      Style="{StaticResource CompactMenuItemStyle}"
                                      Command="{Binding PlacementTarget.DataContext.DeleteShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Setter Property="Foreground" Value="#111827" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="360"
                                            Binding="{Binding Name}"
                                            Header="名称" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Description}"
                                            Header="备注" />
                        <DataGridTextColumn Width="190"
                                            Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            Header="更新时间" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               FontSize="16"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="10"
                                 Minimum="0"
                                 Maximum="{Binding BusyProgressMaximum}"
                                 Value="{Binding BusyProgressValue}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding BusyProgressText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding BusyCurrentItemText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
