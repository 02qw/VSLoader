<Window x:Class="VSLoader.Views.BatchImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量新增识别"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="680"
        MinHeight="560"
        Width="1120"
        MinWidth="920"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F6F7F9">
        <DockPanel Margin="16"
                   IsEnabled="{Binding IsNotBusy}">
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="目标父级文件夹" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Height="34"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Text="{Binding ParentFolderPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Width="96"
                    Margin="8,0,0,0"
                    Command="{Binding BrowseParentFolderCommand}"
                    Content="选择文件夹" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       Text="CSV 规则文件" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Height="34"
                     Margin="0,10,0,0"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Text="{Binding CsvPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Width="96"
                    Margin="8,10,0,0"
                    Command="{Binding BrowseCsvCommand}"
                    Content="选择 CSV" />

            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,12,0,0"
                        Orientation="Horizontal">
                <Button Width="110"
                        Height="34"
                        Command="{Binding ScanPreviewCommand}"
                        Content="扫描预览" />
                <TextBlock Margin="16,8,0,0" Text="{Binding ScannedCount, StringFormat=扫描: {0}}" />
                <TextBlock Margin="16,8,0,0" Text="{Binding ImportableCount, StringFormat=可新增: {0}}" />
                <TextBlock Margin="16,8,0,0" Text="{Binding SelectedImportCount, StringFormat=已选择: {0}}" />
                <TextBlock Margin="16,8,0,0" Text="{Binding SkippedCount, StringFormat=已跳过: {0}}" />
                <TextBlock Margin="16,8,0,0" Text="{Binding DuplicateCount, StringFormat=名称重复: {0}}" />
                <TextBlock Margin="16,8,0,0" Text="{Binding RuleErrorCount, StringFormat=规则错误: {0}}" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Margin="0,0,8,0"
                    Command="{Binding ConfirmImportCommand}"
                    Content="确认新增" />
            <Button Width="88"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
        </StackPanel>

        <Border Margin="0,12,0,0"
                Background="White"
                BorderBrush="#DDE1E7"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      ItemsSource="{Binding PreviewItems}"
                      RowHeaderWidth="0"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="82"
                                            Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Header="是否导入"
                                            IsReadOnly="{Binding CanImport, Converter={StaticResource InverseBooleanConverter}}" />
                    <DataGridTextColumn Width="90"
                                        Binding="{Binding Status}"
                                        Header="状态"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="180"
                                        Binding="{Binding GeneratedName}"
                                        Header="生成名称"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding TargetPath}"
                                        Header="目标路径"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="170"
                                        Binding="{Binding FolderName}"
                                        Header="文件夹名"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="100"
                                        Binding="{Binding MatchedPattern}"
                                        Header="命中规则"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="260"
                                        Binding="{Binding Message}"
                                        Header="说明"
                                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        </DockPanel>

        <Grid Background="#99000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center" />
                    <ProgressBar Height="10"
                                 Margin="0,18,0,0"
                                 Maximum="{Binding BusyProgressMaximum}"
                                 Value="{Binding BusyProgressValue}" />
                    <TextBlock Margin="0,12,0,0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="#475569"
                               Text="{Binding BusyProgressText}"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="#64748B"
                               Text="{Binding BusyCurrentItemText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
