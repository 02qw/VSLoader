<Window x:Class="VSLoader.Views.ShortcutEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="330"
        Width="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Margin="0,0,0,6"
                   Text="名称" />
        <TextBox Grid.Row="1"
                 Grid.ColumnSpan="3"
                 Height="34"
                 Padding="8,6"
                 VerticalContentAlignment="Center"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="3"
                   Margin="0,12,0,6"
                   Text="目标路径" />
        <TextBox Grid.Row="3"
                 Grid.Column="0"
                 Height="34"
                 Padding="8,6"
                 VerticalContentAlignment="Center"
                 Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="3"
                Grid.Column="1"
                Width="92"
                Margin="8,0,0,0"
                Command="{Binding BrowseFolderCommand}"
                Content="选择文件夹" />
        <Button Grid.Row="3"
                Grid.Column="2"
                Width="80"
                Margin="8,0,0,0"
                Command="{Binding BrowseFileCommand}"
                Content="选择文件" />

        <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Margin="0,0,0,6"
                       Text="备注" />
            <TextBox Grid.Row="1"
                     AcceptsReturn="True"
                     Padding="8"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="3"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Content="保存" />
            <Button Width="88"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
        </StackPanel>
    </Grid>
</Window>
