<Window x:Class="VSLoader.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chromeControls="clr-namespace:VSLoader.Views.Controls"
        Title="VSLoader"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Width="420"
        MinHeight="180"
        MaxWidth="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource ModernDialogSurfaceStyle}"
            ClipToBounds="True">
        <Grid Background="{StaticResource ModernSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chromeControls:ModernTitleBar x:Name="DialogTitleBar"
                                           Grid.Row="0" />

            <Grid Grid.Row="1" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        Margin="0,2,16,0"
                        VerticalAlignment="Top"
                        Background="{Binding IconBackground}"
                        CornerRadius="19">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding IconText}" />
                </Border>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="14"
                           Foreground="{StaticResource ModernPrimaryTextBrush}"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="16"
                    Background="#F8FAFC">
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="NoButton"
                            Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                            Width="88"
                            Margin="0,0,8,0"
                            Click="NoButton_Click"
                            Content="否" />
                    <Button x:Name="YesButton"
                            Style="{StaticResource ModernDialogPrimaryButtonStyle}"
                            Width="88"
                            Click="YesButton_Click"
                            Content="是" />
                    <Button x:Name="OkButton"
                            Style="{StaticResource ModernDialogPrimaryButtonStyle}"
                            Width="88"
                            Click="OkButton_Click"
                            Content="确定" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
