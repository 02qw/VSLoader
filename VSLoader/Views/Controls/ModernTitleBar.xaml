<UserControl x:Class="VSLoader.Views.Controls.ModernTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="44">
    <Border Background="{StaticResource ModernTitleBarBackgroundBrush}"
            BorderBrush="{StaticResource ModernTitleBarBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Image Width="18"
                       Height="18"
                       Margin="0,0,8,0"
                       Source="pack://application:,,,/Assets/tomato.ico" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="13"
                           Foreground="{StaticResource ModernSecondaryTextBrush}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource ModernTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click"
                        ToolTip="最小化">
                    <Viewbox Width="14"
                             Height="14">
                        <Path Width="1024"
                              Height="1024"
                              Data="{StaticResource ModernTitleBarMinimizeIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" />
                    </Viewbox>
                </Button>
                <Button x:Name="MaximizeRestoreButton"
                        Style="{StaticResource ModernTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeRestoreButton_Click"
                        ToolTip="最大化/还原">
                    <Grid Width="14"
                          Height="14">
                        <Viewbox x:Name="MaximizeIcon">
                            <Path Width="1024"
                                  Height="1024"
                                  Data="{StaticResource ModernTitleBarMaximizeIconGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                        <Viewbox x:Name="RestoreIcon"
                                 Visibility="Collapsed">
                            <Path Width="1024"
                                  Height="1024"
                                  Data="{StaticResource ModernTitleBarWindowedIconGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource ModernTitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <Viewbox Width="14"
                             Height="14">
                        <Path Width="1024"
                              Height="1024"
                              Data="{StaticResource ModernTitleBarCloseIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
