<UserControl x:Class="VSLoader.Views.Controls.ModernTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="44">
    <Border Background="{StaticResource ModernTitleBarBackgroundBrush}"
            BorderBrush="{StaticResource ModernTitleBarBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Image Width="18"
                       Height="18"
                       Margin="0,0,8,0"
                       Source="pack://application:,,,/Assets/tomato.ico" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="13"
                           Foreground="{StaticResource ModernSecondaryTextBrush}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource ModernTitleBarButtonStyle}"
                        Click="MinimizeButton_Click"
                        ToolTip="最小化">
                    <Grid Width="14"
                          Height="14">
                        <Line X1="1"
                              Y1="7"
                              X2="13"
                              Y2="7"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
                <Button x:Name="MaximizeRestoreButton"
                        Style="{StaticResource ModernTitleBarButtonStyle}"
                        Click="MaximizeRestoreButton_Click"
                        ToolTip="最大化/还原">
                    <Grid Width="14"
                          Height="14">
                        <Rectangle x:Name="MaximizeIcon"
                                   Width="11"
                                   Height="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.5" />
                        <Grid x:Name="RestoreIcon"
                              Visibility="Collapsed">
                            <Rectangle Width="9"
                                       Height="9"
                                       Margin="1,4,4,1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.5" />
                            <Rectangle Width="9"
                                       Height="9"
                                       Margin="4,1,1,4"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.5" />
                        </Grid>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ModernTitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <Grid Width="14"
                          Height="14">
                        <Line X1="3"
                              Y1="3"
                              X2="11"
                              Y2="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Line X1="11"
                              Y1="3"
                              X2="3"
                              Y2="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
