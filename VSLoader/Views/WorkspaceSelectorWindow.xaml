<Window x:Class="VSLoader.Views.WorkspaceSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:chromeControls="clr-namespace:VSLoader.Views.Controls"
        xmlns:behaviors="clr-namespace:VSLoader.Behaviors"
        Title="选择工作区"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="540"
        Width="760"
        MinHeight="480"
        MinWidth="700"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource ModernContextMenuStyle}" />
        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource ModernMenuItemStyle}" />
        <Style x:Key="WorkspaceButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F8FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C9D7EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF3FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A0AEC0" />
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryWorkspaceButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WorkspaceButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#EFF6FF" />
                                <Setter TargetName="Root" Property="Background" Value="#93C5FD" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerWorkspaceButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WorkspaceButtonStyle}">
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#F3C7C7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FEF2F2" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FCA5A5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FEE2E2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FCA5A5" />
                                <Setter TargetName="Root" Property="Background" Value="#FFF7F7" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F4DADA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F6F9FF"
            BorderBrush="{StaticResource ModernWindowOuterBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid Background="#F6F9FF"
          TextElement.FontFamily="Microsoft YaHei UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <chromeControls:ModernTitleBar Grid.Row="0" />
        <Grid Grid.Row="1">

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           Text="VSLoader 工作区" />
                <TextBlock Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="#64748B"
                           Text="选择一个工作区继续，或新建独立工作区管理不同产线配置。" />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="8"
                    Background="#FFFFFF"
                    BorderBrush="#E3EAF3"
                    BorderThickness="1"
                    CornerRadius="10">
                <ListBox x:Name="WorkspaceList"
                         ItemsSource="{Binding Workspaces}"
                         SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                         MouseDoubleClick="WorkspaceList_MouseDoubleClick"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                         behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                         behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                         ScrollViewer.PanningMode="VerticalOnly"
                         ScrollViewer.PanningRatio="1"
                         ScrollViewer.PanningDeceleration="0.001"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <EventSetter Event="PreviewMouseRightButtonDown"
                                         Handler="WorkspaceItem_PreviewMouseRightButtonDown" />
                            <EventSetter Event="ContextMenuOpening"
                                         Handler="WorkspaceItem_ContextMenuOpening" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemRoot"
                                    Margin="0,0,0,8"
                                    Padding="14,12"
                                    Background="#FFFFFF"
                                    BorderBrush="#EEF3FA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="SelectedIndicator"
                                            Background="Transparent"
                                            CornerRadius="2" />

                                    <Grid Grid.Column="1"
                                          Margin="12,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#172033"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <Border x:Name="StatusBadge"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Padding="8,2"
                                                CornerRadius="6"
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1">
                                            <TextBlock Foreground="#64748B"
                                                       FontSize="12"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,7,0,0"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   Text="{Binding Path}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="#94A3B8">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="创建：{0:yyyy-MM-dd HH:mm}    更新：{1:yyyy-MM-dd HH:mm}">
                                                    <Binding Path="CreatedAt" />
                                                    <Binding Path="UpdatedAt" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                             Value="True">
                                    <Setter TargetName="ItemRoot" Property="Background" Value="#F4F8FF" />
                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#D7E8FF" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">
                                    <Setter TargetName="ItemRoot" Property="Background" Value="#EAF3FF" />
                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#B8D4FF" />
                                    <Setter TargetName="SelectedIndicator" Property="Background" Value="#2563EB" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasStatus}"
                                             Value="False">
                                    <Setter TargetName="StatusBadge" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal">
                    <Button Width="116"
                            Margin="0,0,10,8"
                            Command="{Binding StartCreateWorkspaceCommand}"
                            Content="新建工作区"
                            Style="{StaticResource WorkspaceButtonStyle}" />
                    <Button Width="96"
                            Margin="0,0,10,8"
                            Command="{Binding StartRenameWorkspaceCommand}"
                            Content="重命名"
                            Style="{StaticResource WorkspaceButtonStyle}" />
                    <Button Width="96"
                            Margin="0,0,10,8"
                            Command="{Binding StartDeleteWorkspaceCommand}"
                            Content="删除"
                            Style="{StaticResource DangerWorkspaceButtonStyle}" />
                    <Button Width="144"
                            Margin="0,0,10,8"
                            Command="{Binding OpenWorkspaceFolderCommand}"
                            Content="打开工作区文件夹"
                            Style="{StaticResource WorkspaceButtonStyle}" />
                </WrapPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            Orientation="Horizontal">
                    <Button Width="96"
                            Margin="0,0,10,8"
                            Command="{Binding CancelCommand}"
                            Content="取消"
                            Style="{StaticResource WorkspaceButtonStyle}" />
                    <Button Width="96"
                            Margin="0,0,0,8"
                            Command="{Binding OpenSelectedWorkspaceCommand}"
                            Content="打开"
                            Style="{StaticResource PrimaryWorkspaceButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
            </Grid>
    </Grid>
    </Border>
</Window>
