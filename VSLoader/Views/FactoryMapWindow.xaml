<Window x:Class="VSLoader.Views.FactoryMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工厂地图"
        Width="620"
        Height="720"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <DockPanel Background="#F6F7F9">
        <Border DockPanel.Dock="Top"
                Padding="10,7"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="EditModeButton"
                        DockPanel.Dock="Left"
                        MinWidth="72"
                        Height="28"
                        Click="EditModeButton_Click"
                        Content="锁定"
                        Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        Foreground="#991B1B"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        ToolTip="切换地图编辑模式" />
                <Button x:Name="ConnectModeButton"
                        DockPanel.Dock="Left"
                        MinWidth="72"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="ConnectModeButton_Click"
                        Content="连线"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        Foreground="#334155"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        ToolTip="进入或退出连线模式" />
                <Button x:Name="MultiSelectModeButton"
                        DockPanel.Dock="Left"
                        MinWidth="82"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="MultiSelectModeButton_Click"
                        Content="多选节点"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        Foreground="#334155"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        ToolTip="框选多个节点并整体移动" />
                <Button x:Name="ImportMapButton"
                        DockPanel.Dock="Left"
                        MinWidth="92"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="ImportMapButton_Click"
                        Content="导入图文件"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        Foreground="#334155"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        ToolTip="导入别人导出的地图 JSON 文件" />
                <Button x:Name="ExportMapButton"
                        DockPanel.Dock="Left"
                        MinWidth="92"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="ExportMapButton_Click"
                        Content="导出图文件"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        Foreground="#334155"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        ToolTip="导出当前地图 JSON 文件" />
                <Button x:Name="DownloadAdminUiLinksButton"
                        DockPanel.Dock="Left"
                        MinWidth="92"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="DownloadAdminUiLinksButton_Click"
                        Content="自动获取连接"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        Foreground="#334155"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        ToolTip="批量获取快捷项 AdminUI 连接" />
                <TextBlock x:Name="ModeStatusText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="12"
                           Text="浏览模式：滚轮缩放，拖动空白区域平移地图" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="10,7"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#64748B"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       Text="地图未加载" />
        </Border>

        <Grid x:Name="MapViewport"
              ClipToBounds="True"
              Background="#F8FAFC"
              SizeChanged="MapViewport_SizeChanged"
              MouseWheel="MapViewport_MouseWheel"
              MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
              MouseMove="MapViewport_MouseMove"
              MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
              MouseLeave="MapViewport_MouseLeave"
              LostMouseCapture="MapViewport_LostMouseCapture">
            <Canvas x:Name="MapCanvas"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ClipToBounds="False"
                    Background="#F8FAFC"
                    RenderTransformOrigin="0,0">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MapScaleTransform"
                                        ScaleX="1"
                                        ScaleY="1" />
                        <TranslateTransform x:Name="MapTranslateTransform"
                                            X="0"
                                            Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
