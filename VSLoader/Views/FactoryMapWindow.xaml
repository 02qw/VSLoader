<Window x:Class="VSLoader.Views.FactoryMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:chromeControls="clr-namespace:VSLoader.Views.Controls"
        Title="工厂地图"
        Width="620"
        Height="720"
        MinWidth="460"
        MinHeight="360"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        InputMethod.IsInputMethodEnabled="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource ModernContextMenuStyle}" />
        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource ModernMenuItemStyle}" />
    </Window.Resources>
    <Border Background="{StaticResource ModernAppBackgroundBrush}"
            BorderBrush="{StaticResource ModernWindowOuterBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <chromeControls:ModernTitleBar x:Name="MapTitleBar"
                                       Grid.Row="0" />
        <Grid Grid.Row="1">

        <DockPanel Background="{StaticResource ModernAppBackgroundBrush}">
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource ModernToolStripStyle}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button x:Name="EditModeButton"
                            DockPanel.Dock="Left"
                            MinWidth="72"
                            Height="28"
                            Click="EditModeButton_Click"
                            Content="锁定"
                            Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            Foreground="#991B1B"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            ToolTip="切换地图编辑模式" />
                    <Button x:Name="ConnectModeButton"
                            Style="{StaticResource ModernToolbarButtonStyle}"
                            DockPanel.Dock="Left"
                            MinWidth="72"
                            Height="28"
                            Margin="8,0,0,0"
                            Click="ConnectModeButton_Click"
                            Content="连线"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            ToolTip="进入或退出连线模式" />
                    <Button x:Name="MultiSelectModeButton"
                            Style="{StaticResource ModernToolbarButtonStyle}"
                            DockPanel.Dock="Left"
                            MinWidth="82"
                            Height="28"
                            Margin="8,0,0,0"
                            Click="MultiSelectModeButton_Click"
                            Content="多选节点"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            ToolTip="框选多个节点并整体移动" />
                    <Button x:Name="ImportMapButton"
                            Style="{StaticResource ModernToolbarButtonStyle}"
                            DockPanel.Dock="Left"
                            MinWidth="92"
                            Height="28"
                            Margin="8,0,0,0"
                            Click="ImportMapButton_Click"
                            Content="导入图文件"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            ToolTip="导入别人导出的地图 JSON 文件" />
                    <Button x:Name="ExportMapButton"
                            Style="{StaticResource ModernToolbarButtonStyle}"
                            DockPanel.Dock="Left"
                            MinWidth="92"
                            Height="28"
                            Margin="8,0,0,0"
                            Click="ExportMapButton_Click"
                            Content="导出图文件"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            ToolTip="导出当前地图 JSON 文件" />
                    <Button x:Name="DownloadAdminUiLinksButton"
                            Style="{StaticResource ModernToolbarButtonStyle}"
                            DockPanel.Dock="Left"
                            MinWidth="92"
                            Height="28"
                            Margin="8,0,0,0"
                            Click="DownloadAdminUiLinksButton_Click"
                            Content="自动获取连接"
                            FontFamily="Microsoft YaHei UI"
                            FontSize="12"
                            ToolTip="批量获取快捷项 AdminUI 连接" />
                    <TextBlock x:Name="ModeStatusText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Text="浏览模式：滚轮缩放，拖动空白区域平移地图" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Padding="10,7"
                    Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="{StaticResource ModernSurfaceBorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Foreground="#64748B"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="12"
                           Text="地图未加载" />
            </Border>

            <Grid x:Name="MapViewport"
                  ClipToBounds="True"
                  Background="#F7FAFF"
                  SizeChanged="MapViewport_SizeChanged"
                  MouseWheel="MapViewport_MouseWheel"
                  MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                  MouseMove="MapViewport_MouseMove"
                  MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                  MouseLeave="MapViewport_MouseLeave"
                  LostMouseCapture="MapViewport_LostMouseCapture">
                <Canvas x:Name="MapCanvas"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        Background="#F7FAFF"
                        RenderTransformOrigin="0,0">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MapScaleTransform"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <TranslateTransform x:Name="MapTranslateTransform"
                                                X="0"
                                                Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>
            </Grid>
        </DockPanel>

        <Border Background="#660F172A"
                Visibility="{Binding IsMapBusyOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ModernBusyPanelStyle}"
                    Width="420"
                    MaxWidth="520"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModernSurfaceBrush}"
                    BorderBrush="{StaticResource ModernSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               FontSize="16"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="10"
                                 Minimum="0"
                                 Maximum="{Binding BusyProgressMaximum}"
                                 Value="{Binding BusyProgressValue}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding BusyProgressText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding BusyCurrentItemText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
            </Grid>
    </Grid>
    </Border>
</Window>
