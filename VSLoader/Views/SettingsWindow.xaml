<Window x:Class="VSLoader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:chromeControls="clr-namespace:VSLoader.Views.Controls"
        xmlns:behaviors="clr-namespace:VSLoader.Behaviors"
        Title="设置"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="720"
        Width="760"
        MinHeight="520"
        MinWidth="680"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource ModernAppBackgroundBrush}"
            BorderBrush="{StaticResource ModernWindowOuterBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid Background="{StaticResource ModernAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <chromeControls:ModernTitleBar Grid.Row="0" />
        <Grid Grid.Row="1" Background="{StaticResource ModernAppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource ModernDividerBrush}"
                    BorderThickness="0,0,0,1">
                <ListBox x:Name="SettingsPageTabs"
                         Margin="18,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding SettingsPages}"
                         SelectedItem="{Binding SelectedSettingsPage, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="15,11" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource ModernSecondaryTextBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="Foreground" Value="{StaticResource ModernPrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Grid Grid.Row="1" Margin="18,14,18,0">
                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsGeneralPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <GroupBox Header="VSCode" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="34"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 PreviewMouseWheel="SettingsInput_PreviewMouseWheel"
                                 Text="{Binding VSCodePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ModernButtonStyle}"
                                Width="80"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseExeCommand}"
                                Content="浏览" />
                    </Grid>
                </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAdminUiPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <GroupBox Header="AdminUI" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="BaseUrl" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Host" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.Host, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="RoleName" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.RoleName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Properties 文件名" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.InstancePropertiesName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="实例名字段" />
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.InstanceNameKey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="端口字段" />
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.PortKey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="服务名字段" />
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.ServiceNameKey, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="7"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,8"
                                  Content="忽略 HTTPS 证书错误"
                                  IsChecked="{Binding AdminUi.IgnoreCertificateErrors, Mode=TwoWay}" />

                        <CheckBox Grid.Row="8"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,8"
                                  Content="自动粘贴密码并回车"
                                  IsChecked="{Binding AdminUi.AutoPastePasswordEnabled, Mode=TwoWay}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Text="登录窗口标题关键字" />
                        <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" ToolTip="用于识别 AdminUI 登录弹窗，例如 TAOI008.processor 可填写 processor。" Text="{Binding AdminUi.AutoPasteWindowTitleKeyword, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="等待超时秒数" />
                        <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding AdminUi.AutoPasteTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="AdminUI 密码" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="登录密码" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="34"
                                 PreviewMouseWheel="SettingsInput_PreviewMouseWheel"
                                 Text="{Binding AdminUiPassword, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsWebUiPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <GroupBox Header="WebUI" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="BaseUrl" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding WebUi.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Properties 文件名" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding WebUi.InstancePropertiesName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="实例名字段" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" Margin="0,0,0,8" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding WebUi.InstanceNameKey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="SSL 端口字段" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="34" PreviewMouseWheel="SettingsInput_PreviewMouseWheel" Text="{Binding WebUi.SslPortKey, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsUpdatesPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <GroupBox Header="软件更新" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="manifest 路径" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="34"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 PreviewMouseWheel="SettingsInput_PreviewMouseWheel"
                                 Text="{Binding SoftwareUpdateManifestPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ModernButtonStyle}"
                                Width="72"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseSoftwareUpdateManifestCommand}"
                                Content="浏览" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="更新检测" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="全局配置包路径" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="34"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 PreviewMouseWheel="SettingsInput_PreviewMouseWheel"
                                 Text="{Binding UpdateCheck.GlobalConfigPackagePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource ModernButtonStyle}"
                                Width="72"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseGlobalConfigPackageCommand}"
                                Content="浏览" />
                    </Grid>
                </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsHotkeysPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <GroupBox Header="地图快捷键" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Text="只要 VSLoader 正在运行就生效，用于打开、恢复、激活或最小化地图。" />
                        <CheckBox Margin="0,0,0,10"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="启用地图快捷键"
                                  IsChecked="{Binding MapHotkey.Enabled, Mode=TwoWay}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="地图快捷键" />
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource ModernReadOnlyTextBoxStyle}"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     PreviewMouseWheel="SettingsInput_PreviewMouseWheel"
                                     Text="{Binding MapHotkeyDisplayText}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding StartRecordMapHotkeyCommand}"
                                    Content="录制" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearMapHotkeyCommand}"
                                    Content="清除" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="程序快捷键" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <CheckBox Margin="0,0,0,10"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="启用快捷键"
                                  IsChecked="{Binding Hotkey.Enabled, Mode=TwoWay}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="快捷键" />
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource ModernReadOnlyTextBoxStyle}"
                                     Height="34"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     PreviewMouseWheel="SettingsInput_PreviewMouseWheel"
                                     Text="{Binding HotkeyDisplayText}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding StartRecordHotkeyCommand}"
                                    Content="录制" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearHotkeyCommand}"
                                    Content="清除" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsContextMenuCapabilitiesPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                <GroupBox Header="右键菜单能力集合" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,12"
                                   Foreground="{StaticResource ModernSecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="快捷项列表和地图浏览模式共用此顺序。编辑、删除属于系统管理动作，固定显示在菜单底部。" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{StaticResource ModernSecondaryTextBrush}" FontSize="12" Text="启用" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource ModernSecondaryTextBrush}" FontSize="12" Text="名称" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource ModernSecondaryTextBrush}" FontSize="12" Text="类型" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource ModernSecondaryTextBrush}" FontSize="12" Text="显示位置" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource ModernSecondaryTextBrush}" FontSize="12" Text="操作" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ContextMenuCapabilityItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,7"
                                            BorderBrush="{StaticResource ModernDividerBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="230" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource ModernCheckBoxStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource ModernSecondaryTextBrush}"
                                                       Text="{Binding TypeDisplayName}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                <CheckBox Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,8,0" Content="列表" IsChecked="{Binding ShowInShortcutList}" />
                                                <CheckBox Style="{StaticResource ModernCheckBoxStyle}" Content="地图" IsChecked="{Binding ShowInFactoryMap}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource ModernButtonStyle}"
                                                        Width="30"
                                                        MinWidth="30"
                                                        Padding="0"
                                                        Margin="0,0,4,0"
                                                        ToolTip="上移"
                                                        Command="{Binding DataContext.MoveCapabilityUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑" />
                                                <Button Style="{StaticResource ModernButtonStyle}"
                                                        Width="30"
                                                        MinWidth="30"
                                                        Padding="0"
                                                        Margin="0,0,4,0"
                                                        ToolTip="下移"
                                                        Command="{Binding DataContext.MoveCapabilityDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓" />
                                                <Button Style="{StaticResource ModernButtonStyle}"
                                                        Width="48"
                                                        MinWidth="48"
                                                        Padding="0"
                                                        Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditCapabilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="编辑" />
                                                <Button Style="{StaticResource ModernButtonStyle}"
                                                        Width="48"
                                                        MinWidth="48"
                                                        Padding="0"
                                                        Margin="0,0,4,0"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Command="{Binding DataContext.DuplicateCapabilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="复制" />
                                                <Button Style="{StaticResource ModernDangerButtonStyle}"
                                                        Width="48"
                                                        MinWidth="48"
                                                        Padding="0"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Command="{Binding DataContext.DeleteCapabilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="删除" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddPowerShellCapabilityCommand}"
                                    Content="新增 PowerShell" />
                            <Button Style="{StaticResource ModernButtonStyle}"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddWebCapabilityCommand}"
                                    Content="新增 Web" />
                            <Button Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding RestoreDefaultCapabilityOrderCommand}"
                                    Content="恢复默认顺序" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Tag="SettingsPage"
                              behaviors:SmoothTouchpadScrollBehavior.IsEnabled="True"
                              behaviors:SmoothTouchpadScrollBehavior.EnableHorizontal="False"
                              behaviors:SmoothTouchpadScrollBehavior.EnableVertical="True"
                              PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsPageOrderPageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <GroupBox Header="页面顺序" Style="{StaticResource ModernGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,12"
                                           Foreground="{StaticResource ModernSecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="使用上移和下移调整设置标签的显示顺序。页面顺序固定显示在最后，避免管理入口无法找到。修改将在保存设置后持久化。" />

                                <ItemsControl ItemsSource="{Binding SettingsPages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10"
                                                    BorderBrush="{StaticResource ModernDividerBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource ModernWeakTextBrush}"
                                                               Visibility="{Binding IsFixed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Text="固定" />
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Width="64"
                                                            Margin="0,0,6,0"
                                                            IsEnabled="{Binding CanMoveUp}"
                                                            Command="{Binding DataContext.MoveSettingsPageUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="上移" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Width="64"
                                                            IsEnabled="{Binding CanMoveDown}"
                                                            Command="{Binding DataContext.MoveSettingsPageDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="下移" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource ModernButtonStyle}"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RestoreDefaultSettingsPageOrderCommand}"
                                        Content="恢复默认顺序" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="18,12,18,18"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource ModernDividerBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ModernPrimaryButtonStyle}"
                            Width="88"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            Content="保存" />
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Width="88"
                            Command="{Binding CancelCommand}"
                            Content="取消" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>

