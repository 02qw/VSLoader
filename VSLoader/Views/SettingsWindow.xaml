<Window x:Class="VSLoader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="pack://application:,,,/Assets/tomato.ico"
        Height="640"
        Width="760"
        MinHeight="520"
        MinWidth="680"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Content="保存" />
            <Button Width="88"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="VSCode" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="34"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding VSCodePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Width="80"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseExeCommand}"
                                Content="浏览" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="AdminUI" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="BaseUrl" />
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Host" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.Host, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="RoleName" />
                        <TextBox Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.RoleName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Properties 文件名" />
                        <TextBox Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.InstancePropertiesName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="实例名字段" />
                        <TextBox Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.InstanceNameKey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="端口字段" />
                        <TextBox Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.PortKey, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="服务名字段" />
                        <TextBox Grid.Row="6" Grid.Column="1" Height="30" Margin="0,0,0,8" Text="{Binding AdminUi.ServiceNameKey, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="7"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="忽略 HTTPS 证书错误"
                                  IsChecked="{Binding AdminUi.IgnoreCertificateErrors, Mode=TwoWay}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="AdminUI 密码" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="登录密码" />
                        <PasswordBox x:Name="AdminUiPasswordBox"
                                     Grid.Column="1"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Padding="8,4"
                                     PasswordChanged="AdminUiPasswordBox_PasswordChanged" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
