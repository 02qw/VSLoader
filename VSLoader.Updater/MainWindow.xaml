<Window x:Class="VSLoader.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在更新 VSLoader"
        Width="560"
        Height="390"
        MinWidth="520"
        MinHeight="430"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/tomato.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border Margin="18"
            Padding="18"
            Style="{StaticResource ModernDialogSurfaceStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ModernPrimaryTextBrush}"
                   Text="正在更新 VSLoader" />

        <ProgressBar Grid.Row="1"
                     Style="{StaticResource ModernProgressBarStyle}"
                     Margin="0,18,0,12"
                     Maximum="100"
                     Value="{Binding ProgressValue, Mode=OneWay}" />

        <TextBlock Grid.Row="2"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="13"
                   Foreground="{StaticResource ModernBodyTextBrush}"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap" />

        <GroupBox Grid.Row="3"
                  Style="{StaticResource ModernGroupBoxStyle}"
                  Margin="0,14,0,0"
                  Header="本次更新内容"
                  Visibility="{Binding ShowReleaseNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="82"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock FontFamily="Microsoft YaHei UI"
                           FontSize="12"
                           Foreground="{StaticResource ModernBodyTextBrush}"
                           Text="{Binding ReleaseNotesText}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </GroupBox>

        <Border Grid.Row="4"
                Margin="0,14,0,14"
                Style="{StaticResource ModernSurfaceBorderStyle}">
            <ListBox x:Name="DetailList"
                     Style="{StaticResource ModernLogListBoxStyle}"
                     ItemsSource="{Binding DetailLines}" />
        </Border>

        <StackPanel Grid.Row="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="120"
                    Style="{StaticResource ModernDialogSecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Command="{Binding OpenErrorLogDirectoryCommand}"
                    Content="打开日志目录"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Width="80"
                    Style="{StaticResource ModernDialogPrimaryButtonStyle}"
                    Command="{Binding CloseCommand}"
                    Content="关闭"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
